import { UText } from "@sleek-ui/widgets.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { SlintMessageType } from "../globals.slint";

export component MessageText inherits UText {
    in property <SlintMessageType> message-type;

    color: get-color();
    wrap: TextWrap.word-wrap;

    function get-color() -> color {
        // The "hover" brush is lightest against the dark "selected" brush of the background.
        if (root.message-type == SlintMessageType.Error) {
            return UAppTheme.dust-red.hover;
        } else if (root.message-type == SlintMessageType.Info) {
            return UAppTheme.geek-blue.hover;
        } else if (root.message-type == SlintMessageType.Success) {
            return UAppTheme.polar-green.hover;
        } else { // Warning
            return UAppTheme.sunset-orange.hover;
        }
    }
}