import { UCard, UText, } from "@sleek-ui/widgets.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { MidiConnection } from "midi-connection.slint";
import { SlintMessageType } from "../globals.slint";

export enum SlintDeviceType {
    input,
    output
}

export component MidiDevices inherits VerticalLayout {
    padding-top: UAppTheme.padding-medium;

    callback connect-device(device-type: SlintDeviceType);
    callback refresh-devices(device-type: SlintDeviceType);

    in-out property input-devices-model <=> input-connection.devices-model;
    in-out property <int> input-selected-device-index;
    public function input-focus() {
        input-connection.focus-select();
    }
    public function input-show-connected-device-name(name: string, message-type: SlintMessageType) {
        input-connection.show-connected-device-name(name, message-type);
    }

    in-out property output-devices-model <=> output-connection.devices-model;
    in-out property <int> output-selected-device-index;
    public function output-focus() {
        output-connection.focus-select();
    }
    public function output-show-connected-device-name(name: string, message-type: SlintMessageType) {
        output-connection.show-connected-device-name(name, message-type);
    }

    UCard {
        background: UAppTheme.primary.selected; // Darkest
        width: 686px;

        VerticalLayout {
            spacing: UAppTheme.spacing-medium;
            padding: UAppTheme.padding-medium;
            title-layout := VerticalLayout {
                title-text := UText {
                    text: "MIDI Devices";
                    // Lightest against the dark "selected" background
                    color: UAppTheme.primary.hover;
                    font-size: UAppTheme.font-size-medium;
                    font-italic: true;
                }
            }
            input-connection := MidiConnection {
                title: "MIDI Input";
                selected-device-index: root.input-selected-device-index;
                changed selected-device-index => {
                    root.input-selected-device-index = self.selected-device-index;
                }
                connect-device => {
                    root.connect-device(SlintDeviceType.input)
                }
                refresh-devices => {
                    root.refresh-devices(SlintDeviceType.input)
                }
            }
            output-connection := MidiConnection {
                title: "MIDI Output";
                selected-device-index: root.output-selected-device-index;
                changed selected-device-index => {
                    root.output-selected-device-index = self.selected-device-index;
                }
                connect-device => {
                    root.connect-device(SlintDeviceType.output)
                }
                refresh-devices => {
                    root.refresh-devices(SlintDeviceType.output)
                }
            }
        }
    }
}