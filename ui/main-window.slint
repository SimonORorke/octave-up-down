import { Palette, VerticalBox, } from "std-widgets.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { UIconButton, } from "@sleek-ui/widgets.slint";
import { Globals, SlintMessageType } from "globals.slint";
import { Alert } from "components/alert.slint";
import { CcNoRange } from "components/cc.slint";
import { MidiDevices, SlintDeviceType } from "components/midi-devices.slint";
import { ContextMenu } from "components/context_menu.slint";

export { SlintDeviceType }

// As of Slint 18.1 and sleek-ui 1.6.0, Show Preview does not work.
export component MainWindow inherits Window {
    init => {
        Palette.color-scheme = ColorScheme.dark;
//        debug("MainWindow.init:  UAppTheme.dark.font-size-base = " + (UAppTheme.dark.font-size-base / 1px));
        UAppTheme.dark.font-size-base = 17px; // Default 14
        UAppTheme.dark.font-size-medium = 19px; // Default 16
        UAppTheme.dark.font-size-big = 21px; // Default 18
        UAppTheme.dark.font-size-bigger = 23px; // Default 20
        UAppTheme.dark.radius-base = 20px;
//        UAppTheme.dark.primary = UAppTheme.calendula-gold;
//        UAppTheme.dark.primary = UAppTheme.cyan;
//        UAppTheme.dark.primary = UAppTheme.daybreak-blue;
//        UAppTheme.dark.primary = UAppTheme.dust-red;
        UAppTheme.dark.primary = UAppTheme.french-magenta;
//        UAppTheme.dark.primary = UAppTheme.geek-blue;
//        UAppTheme.dark.primary = UAppTheme.golden-purple;
//        UAppTheme.dark.primary = UAppTheme.lime;
//        UAppTheme.dark.primary = UAppTheme.polar-green;
//        UAppTheme.dark.primary = UAppTheme.sunrise-yellow;
//        UAppTheme.dark.primary = UAppTheme.sunset-orange;
//        UAppTheme.dark.primary = UAppTheme.volcano;
    }
    background: Globals.window_background;
    min-width: 700px;
    preferred-height: 325px; // Min height expands automatically so everything fits;
    title: window_title;
    icon: Globals.icon;

    in property <string> window_title;
    in property <int> down_cc_no;
    callback down_cc_no_changed(value: int);
    in property <int> up_cc_no;
    callback up_cc_no_changed(value: int);
    in property <int> in_cc_no;
    callback in_cc_no_changed(value: int);
    in property <int> out_cc_no;
    callback out_cc_no_changed(value: int);

    callback connect_device(device_type: SlintDeviceType);
    callback refresh_devices(device_type: SlintDeviceType);

    // Menu item callbacks
    callback check_for_updates();
    callback open_documentation();
    callback show_about_window();
    callback show_colour_scheme_window();

    public function show_message(message: string, message_type: SlintMessageType) {
        alert.message = @markdown("\{message}");
        alert.message_type = message_type;
    }

    in_out property input_devices_model <=> midi_devices.input_devices_model;
    in_out property <int> input_selected_device_index <=> midi_devices.input_selected_device_index;
    public function input_focus() {
        midi_devices.input_focus();
    }
    public function input_show_connected_device_name(name: string, message_type: SlintMessageType) {
        midi_devices.input_show_connected_device_name(name, message_type);
    }

    in_out property output_devices_model <=> midi_devices.output_devices_model;
    in_out property <int> output_selected_device_index <=> midi_devices.output_selected_device_index;
    public function output_focus() {
        midi_devices.output_focus();
    }
    public function output_show_connected_device_name(name: string, message_type: SlintMessageType) {
        midi_devices.output_show_connected_device_name(name, message_type);
    }

	VerticalLayout {
        alignment: start; // Stops spreading out when window lenghthened.
        padding_left: UAppTheme.padding_medium;
        down_up_range := CcNoRange {
            from_title: "Down CC No";
            from_cc_no: root.down_cc_no;
            from_cc_no_changed(value) => {
//                debug("MainWindow.down_up_range.from_cc_no_changed: " + value);
                root.down_cc_no_changed(value);
            }
            to_title: "Up CC No";
            to_cc_no: root.up_cc_no;
            to_cc_no_changed(value) => {
                root.up_cc_no_changed(value);
            }
        }
        in_out_range := CcNoRange {
            from_title: "In CC No";
            from_cc_no: root.in_cc_no;
            from_cc_no_changed(value) => {
                root.in_cc_no_changed(value);
            }
            to_title: "Out CC No";
            to_cc_no: root.out_cc_no;
            to_cc_no_changed(value) => {
                root.out_cc_no_changed(value);
            }
        }
        midi_devices := MidiDevices {
            connect_device(device_type) => {
                root.connect_device(device_type)
            }
            refresh_devices(device_type) => {
                root.refresh_devices(device_type)
            }
        }
        status_bar_layout := HorizontalLayout {
            icon_layout := HorizontalLayout {
                padding_top: UAppTheme.padding_medium;
                padding_bottom: UAppTheme.padding_medium;
                icon_image := Image {
                    source: Globals.icon;
                    width: 40px; height: 40px; // Default height for menu_button.
                }
            }
            alert_box := VerticalBox {
                alert := Alert {
                    message: @markdown("Radbod, King of the Frisians, is such a rad bod!");
                }
            }
            menu_layout := HorizontalLayout {
                  padding_right: UAppTheme.padding_medium;
                  padding_top: UAppTheme.padding_medium;
                  padding_bottom: UAppTheme.padding_medium;
                // See comment for MidiConnection.show_focus_highlight.
                menu_button := UIconButton {
                    icon: @image-url("images/menu-svgrepo-com.svg");
                    width: 50px;
                    clicked => {
                        main_menu.show({
                            x: self.absolute_position.x,
                            y: self.absolute_position.y + self.height
                        })
                    }
                }
            }
        }
	}

    main_menu := ContextMenu {
        items: [
            { title: "Documentation..." },
            { title: "About..." },
            { title: "Colour Scheme..." },
            { title: "Check for updates..." },
        ];
        item_activated(i) => {
            if (i == 0) { root.open_documentation(); }
            if (i == 1) { root.show_about_window(); }
            if (i == 2) {
                root.show_colour_scheme_window();
//                UAppTheme.dark.primary = UAppTheme.volcano; // It works!
            }
            if (i == 3) { root.check_for_updates(); }
        }
    }
}
