import {
    UButton,
    UCard,
    USelect,
    UText,
} from "@sleek-ui/widgets.slint";
import { UButtonVariant } from "@sleek-ui/common.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { MessageText } from "text.slint";
import { VerticalBox } from "std-widgets.slint";
import { Globals, SlintMessageType } from "../globals.slint";

export component MidiIo inherits UCard {
    background: UAppTheme.primary.selected; // Darkest
    width: 686px;

    in property <string> title;

    in-out property input-devices-model <=> input-devices-select.options;
    in-out property <int> input-selected-device-index;
    callback input-connect-device();
    callback input-refresh-devices();
    public function input-focus() {
        input-devices-select.set-focus();
    }
    public function input-show-connected-device-name(name: string, message-type: SlintMessageType) {
        input-connected-device-name-text.text = name;
        input-connected-device-name-text.message-type = message-type;
    }

    in-out property output-devices-model <=> output-devices-select.options;
    in-out property <int> output-selected-device-index;
    callback output-connect-device();
    callback output-refresh-devices();
    public function output-focus() {
        output-devices-select.set-focus();
    }
    public function output-show-connected-device-name(name: string, message-type: SlintMessageType) {
        output-connected-device-name-text.text = name;
        output-connected-device-name-text.message-type = message-type;
    }
    VerticalLayout {
        spacing: UAppTheme.spacing-medium;
        padding: UAppTheme.padding-medium;
        title-layout := VerticalLayout {
            title-text := UText {
                text: root.title;
                // Lightest against the dark "selected" background
                color: UAppTheme.primary.hover;
                font-size: UAppTheme.font-size-medium;
                font-italic: true;
            }
        }
        padding-top: UAppTheme.padding-medium;
        HorizontalLayout {
            UText {
                text: "MIDI Input";
                vertical-alignment: center;
            }
            VerticalLayout {
                padding-left: UAppTheme.padding-base;
                padding-right: UAppTheme.padding-medium;
                input-devices-select := USelect {
                    current-index: root.input-selected-device-index;
                    changed current-index => {
                        root.input-selected-device-index = self.current-index;
                    }
                    height: Globals.control-height;
                    width: 420px;
                }
            }
            VerticalLayout {
                UButton {
                    text: "Connect";
                    variant: UButtonVariant.primary;
                    clicked => {
                        root.input-connect-device()
                    }
                    height: Globals.control-height;
                    width: Globals.button-width;
                }
            }
        }
        GridLayout {
            VerticalLayout {
                col: 0;
                UText {
                    text: "Connected: ";
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                col: 1;
                input-connected-device-name-text := MessageText {
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                col: 2;
                UButton {
                    text: "Refresh Devices";
                    clicked => {
                        root.input-refresh-devices()
                    }
                    height: Globals.control-height;
                    width: 160px;
                }
            }
        }
        HorizontalLayout {
        padding-top: UAppTheme.padding-bigger;
            UText {
                text: "MIDI Output";
                vertical-alignment: center;
            }
            VerticalLayout {
                padding-left: UAppTheme.padding-base;
                padding-right: UAppTheme.padding-medium;
                output-devices-select := USelect {
                    current-index: root.output-selected-device-index;
                    changed current-index => {
                        root.output-selected-device-index = self.current-index;
                    }
                    height: Globals.control-height;
                    width: 420px;
                }
            }
            VerticalLayout {
                UButton {
                    text: "Connect";
                    variant: UButtonVariant.primary;
                    clicked => {
                        root.output-connect-device()
                    }
                    height: Globals.control-height;
                    width: Globals.button-width;
                }
            }
        }
        GridLayout {
            VerticalLayout {
                col: 0;
                UText {
                    text: "Connected: ";
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                col: 1;
                output-connected-device-name-text := MessageText {
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                col: 2;
                UButton {
                    text: "Refresh Devices";
                    clicked => {
                        root.output-refresh-devices()
                    }
                    height: Globals.control-height;
                    width: 160px;
                }
            }
        }
    }
}