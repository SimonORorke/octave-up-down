import { Palette, VerticalBox, } from "std-widgets.slint";
import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { UIconButton, } from "@sleek-ui/widgets.slint";
import { Globals, SlintMessageType } from "globals.slint";
import { Alert } from "components/alert.slint";
import { CcNoRange } from "components/cc.slint";
import { MidiDevices, SlintDeviceType } from "components/midi-devices.slint";

export { SlintDeviceType }

// As of Slint 18.1 and sleek-ui 1.6.0, Show Preview does not work.
export component MainWindow inherits Window {
    init => {
        Palette.color-scheme = ColorScheme.dark;
//        debug("MainWindow.init:  UAppTheme.dark.font-size-base = " + (UAppTheme.dark.font-size-base / 1px));
        UAppTheme.dark.font-size-base = 17px; // Default 14
        UAppTheme.dark.font-size-medium = 19px; // Default 16
        UAppTheme.dark.font-size-big = 21px; // Default 18
        UAppTheme.dark.font-size-bigger = 23px; // Default 20
        UAppTheme.dark.radius-base = 20px;
//        UAppTheme.dark.primary = UAppTheme.calendula-gold;
//        UAppTheme.dark.primary = UAppTheme.cyan;
//        UAppTheme.dark.primary = UAppTheme.daybreak-blue;
//        UAppTheme.dark.primary = UAppTheme.dust-red;
        UAppTheme.dark.primary = UAppTheme.french-magenta;
//        UAppTheme.dark.primary = UAppTheme.geek-blue;
//        UAppTheme.dark.primary = UAppTheme.golden-purple;
//        UAppTheme.dark.primary = UAppTheme.lime;
//        UAppTheme.dark.primary = UAppTheme.polar-green;
//        UAppTheme.dark.primary = UAppTheme.sunrise-yellow;
//        UAppTheme.dark.primary = UAppTheme.sunset-orange;
//        UAppTheme.dark.primary = UAppTheme.volcano;
    }
    background: Globals.window_background;
    min-width: 700px;
    preferred-height: 325px; // Min height expands automatically so everything fits;
    title: window-title;
    icon: Globals.icon;

    in property <string> window-title;
    in property <int> down-cc-no;
    callback down-cc-no-changed(value: int);
    in property <int> up-cc-no;
    callback up-cc-no-changed(value: int);
    in property <int> in-cc-no;
    callback in-cc-no-changed(value: int);
    in property <int> out-cc-no;
    callback out-cc-no-changed(value: int);

    callback connect-device(device-type: SlintDeviceType);
    callback refresh-devices(device-type: SlintDeviceType);

    public function show-message(message: string, message-type: SlintMessageType) {
        alert.message = @markdown("\{message}");
        alert.message-type = message-type;
    }

    in-out property input-devices-model <=> midi-devices.input-devices-model;
    in-out property <int> input-selected-device-index <=> midi-devices.input-selected-device-index;
    public function input-focus() {
        midi-devices.input-focus();
    }
    public function input-show-connected-device-name(name: string, message-type: SlintMessageType) {
        midi-devices.input-show-connected-device-name(name, message-type);
    }

    in-out property output-devices-model <=> midi-devices.output-devices-model;
    in-out property <int> output-selected-device-index <=> midi-devices.output-selected-device-index;
    public function output-focus() {
        midi-devices.output-focus();
    }
    public function output-show-connected-device-name(name: string, message-type: SlintMessageType) {
        midi-devices.output-show-connected-device-name(name, message-type);
    }

	VerticalLayout {
        alignment: start; // Stops spreading out when window lenghthened.
        padding-left: UAppTheme.padding-medium;
        down-up-range := CcNoRange {
            from-title: "Down CC No";
            from-cc-no: root.down-cc-no;
            from-cc-no-changed(value) => {
//                debug("MainWindow.down-up-range.from-cc-no-changed: " + value);
                root.down-cc-no-changed(value);
            }
            to-title: "Up CC No";
            to-cc-no: root.up-cc-no;
            to-cc-no-changed(value) => {
                root.up-cc-no-changed(value);
            }
        }
        in-out-range := CcNoRange {
            from-title: "In CC No";
            from-cc-no: root.in-cc-no;
            from-cc-no-changed(value) => {
                root.in-cc-no-changed(value);
            }
            to-title: "Out CC No";
            to-cc-no: root.out-cc-no;
            to-cc-no-changed(value) => {
                root.out-cc-no-changed(value);
            }
        }
        midi-devices := MidiDevices {
            connect-device(device-type) => {
                root.connect-device(device-type)
            }
            refresh-devices(device-type) => {
                root.refresh-devices(device-type)
            }
        }
        status-bar-layout := HorizontalLayout {
            icon-layout := HorizontalLayout {
                padding_top: UAppTheme.padding-medium;
                padding-bottom: UAppTheme.padding-medium;
                icon-image := Image {
                    source: Globals.icon;
                    width: 40px; height: 40px; // Default height for menu_button.
                }
            }
            alert-box := VerticalBox {
                alert := Alert {
                    message: @markdown("Radbod, King of the Frisians, is such a rad bod!");
                }
            }
            menu_layout := HorizontalLayout {
                  padding_right: UAppTheme.padding-medium;
                  padding_top: UAppTheme.padding-medium;
                  padding-bottom: UAppTheme.padding-medium;
                // If I tab through the main window to focus the menu button and then press
                // Enter to open the menu, when I exit the menu, pressing enter again does not
                // reopen the menu, even though the menu button is still focused.
                // I need to tab away from the menu button and then tab back to it for Enter
                // to work again. But this is almost certainly just normal behaviour for
                // Slint buttons: Slint's internal focus state for the button's own FocusScope
                // isn't properly re-activated by programmatic focus() calls, only by tab
                // navigation.
                // See also comment for MidiConnection.show-focus-highlight.
                menu_button := UIconButton {
                    icon: @image-url("images/menu-svgrepo-com.svg");
                    width: 50px;
                    clicked => {
//                        debug("MainWindow.menu_button.height: " + self.height / 1px);
//                        debug("MainWindow.icon-image.width: " + icon-image.width / 1px);
//                        debug("MainWindow.icon-image.height: " + icon-image.height / 1px);
//                        main_menu.show({
//                            x: self.absolute-position.x,
//                            y: self.absolute-position.y + self.height
//                        })
                    }
                }
            }
        }
	}
}
