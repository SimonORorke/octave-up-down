import { UAppTheme } from "@sleek-ui/app-theme.slint";
import { UInputNumber, UText } from "@sleek-ui/widgets.slint";
import { NiceCard } from "nice_card.slint";

export component CcNoInput inherits HorizontalLayout {
    in property <string> title;
    in property <int> cc-no;
    callback cc-no-changed(value: int);

    UText {
        text: root.title;
        preferred-width: 105px;
        vertical-alignment: center;
    }
    number_layout := VerticalLayout {
        padding_top: UAppTheme.padding-base;
        number:= UInputNumber {
            value: root.cc-no;
             // `edited` fires on every typed keystroke (not on Enter), but
             // range validation/correction doesn't work reliably there;
             // `accepted` does the validation correctly but, like `edited`,
             // fires only for typed changes, not for the increase/decrease
             // buttons (or the arrow keys, which trigger those buttons
             // internally). `changed value` fires for every way `value` can
             // change, so it is used here instead, without needing to modify
             // the sleek-ui-provided UInputNumber widget.
            enable-min-max: true;
            min-value: 0;
            max-value: 127;
            preferred-width: 95px;
            accepted => {
                if self.value < self.min-value {
                    self.value = self.min-value;
                }
                if self.value > self.max-value {
                    self.value = self.max-value;
                }
            }
            changed value => {
//                debug("CcNoInput.number.value changed: " + self.value);
                root.cc-no-changed(self.value);
            }
        }
    }
}

export component CcNoRange inherits HorizontalLayout {
    padding-top: UAppTheme.padding-medium;

    in property <string> from-title;
    in property <int> from-cc-no;
    callback from-cc-no-changed(value: int);
    in property <string> to-title;
    in property <int> to-cc-no;
    callback to-cc-no-changed(value: int);

    NiceCard {
        width: 686px;

        HorizontalLayout {
            alignment: space-evenly;
            from-input := CcNoInput {
                title: root.from-title;
                cc-no: root.from-cc-no;
                cc-no-changed(value) => {
//                    debug("CcNoRange.from-input.cc-no-changed: " + value);
                    root.from-cc-no-changed(value);
                }
            }
            to-input := CcNoInput {
                title: root.to-title;
                cc-no: root.to-cc-no;
                cc-no-changed(value) => {
                    root.to-cc-no-changed(value);
                }
            }
        }
    }
}